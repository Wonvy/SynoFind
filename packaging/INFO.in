package="synofind"
version="@VERSION@-@BUILD@"
displayname="SynoFind"
description="Read-only filename search, preview and download through Synology File Station APIs."
description_chs="通过群晖 File Station API 只读搜索文件名、预览和下载文件。"
maintainer="SynoFind"
arch="apollolake"
os_min_ver="7.1-42962"
thirdparty="yes"
install_type="volume"
ctl_stop="yes"
ctl_uninstall="yes"
silent_install="no"
silent_upgrade="no"
silent_uninstall="yes"
precheckstartstop="yes"
checkport="no"
dsmuidir="ui"
dsmappname="com.synofind.web"
adminprotocol="http"
adminport="8787"
adminurl=""
checksum="@CHECKSUM@"
