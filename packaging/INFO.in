package="synofind"
version="@VERSION@-@BUILD@"
displayname="SynoFind"
description="Personal file search, preview and download API for Synology NAS."
description_chs="在局域网快速搜索、预览和下载个人文件，提供文件读取 API。"
maintainer="SynoFind"
arch="apollolake"
os_min_ver="7.1-42962"
thirdparty="yes"
install_type="volume"
ctl_stop="yes"
ctl_uninstall="yes"
silent_install="no"
silent_upgrade="yes"
silent_uninstall="yes"
precheckstartstop="yes"
checkport="no"
dsmuidir="ui"
dsmappname="com.synofind.web"
adminprotocol="http"
adminport="8787"
adminurl=""
checksum="@CHECKSUM@"
