        "summary": "Public liveness check without personal data",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token created in the SynoFind settings page."
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "synofind_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "csrf_token": {
            "type": "string"
          }
        },
        "required": [
          "authenticated",
          "csrf_token"
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque file identifier; obtain it from search."
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Root-relative path with forward slashes."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          },
          "extension": {
            "type": "string"
          },
          "preview_type": {
            "type": "string",
            "enum": [
              "image",
              "pdf",
              "text",
              ""
            ]
          },
          "smb_path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "size",
          "modified_at",
          "extension",
          "preview_type",
          "smb_path"
        ]
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ]
      },
      "IndexStatus": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "last_search_at": {
            "type": "string",
            "description": "UTC RFC3339; empty string if not yet available."
          },
          "last_error": {
            "type": "string"
          },
          "root_path": {
            "type": "string"
          }
        },
        "required": [
          "connected",
          "last_error",
          "root_path"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "root_path": {
            "type": "string"
          },
          "smb_root": {
            "type": "string"
          },
          "dsm_url": {
            "type": "string"
          },
          "dsm_username": {
            "type": "string"
          },
          "has_dsm_password": {
            "type": "boolean"
          },
          "port": {
            "type": "integer",
            "readOnly": true,
            "minimum": 1024,
            "maximum": 65535
          }
        },
        "required": [
          "root_path",
          "smb_root",
          "dsm_url",
          "dsm_username",
          "has_dsm_password",
          "port"
        ]
      },
      "SettingsUpdate": {
        "type": "object",
        "properties": {
          "root_path": {
            "type": "string"
          },
          "smb_root": {
            "type": "string"
          },
          "dsm_url": {
            "type": "string"
          },
          "dsm_username": {
            "type": "string"
          },
          "dsm_password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "required": [
          "root_path",
          "smb_root",
          "dsm_url",
          "dsm_username"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "description": "UTC RFC3339; empty string if not yet available."
          },
          "last_used_at": {
            "type": "string",
            "description": "UTC RFC3339; empty string if not yet available."
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ]
      },
      "TokenCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "description": "UTC RFC3339; empty string if not yet available."
          },
          "token": {
            "type": "string",
            "description": "Only revealed in this response; store securely."
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "token"
        ]
      },
      "TokenList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Token"
            }
          }
        },
        "required": [
          "items"
        ]
      }
    }
  }
}
