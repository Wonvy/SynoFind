{
  "openapi": "3.0.3",
  "info": {
    "title": "SynoFind API",
    "version": "0.2.0",
    "description": "Personal read-only filename search and file retrieval through Synology File Station APIs. DSM credentials are write-only settings and are never returned."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same SynoFind origin"
    }
  ],
  "security": [
    {
      "ApiToken": []
    },
    {
      "SessionCookie": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Log in to the personal web account",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access or CSRF denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": [
                  "password"
                ]
              }
            }
          }
        }
      }
    },
